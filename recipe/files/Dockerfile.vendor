# =====================================================================
# NetBox v4.7.4 (Apache-2.0) VENDOR build. Django-AIO (paperless pattern, gunicorn flavor):
#  clone tag -> pip install pinned requirements.txt into a venv (+ post-install CVE --upgrade) ->
#  the application tree (CPython compiled from source against Ubuntu's libraries) with collectstatic (BUILD-time) +
#  supervisord from PyPI (gunicorn web + rqworker). NO node build (project-static/dist is prebuilt in the tag). Exports the
#  venv + NetBox tree as tars and the chiselled Ubuntu 24.04 runtime (chiselcut) for the hermetic offline reassembly
#  FROM scratch (runtime_base, from v4.7.4-CE-ubuntu24.04-r4). Non-root netbox uid 1000.
# =====================================================================
ARG NETBOX_VERSION=4.7.4

# alpine/git 2.54.0 by its index digest (Docker Hub's registry, read 2026-11-02): only a git client for the clone below;
# the tag and the commit check below pin the source, the digest pins the client that fetched it.
FROM alpine/git:2.54.0@sha256:ac6c828f15d82775d204d3d75112e1d34af8945da80ccf922713c9891ba68e7a AS src
ARG NETBOX_VERSION
RUN git clone --depth 1 --branch v${NETBOX_VERSION} https://github.com/netbox-community/netbox /opt/netbox && \
    test "$(git -C /opt/netbox rev-parse HEAD)" = 9b9844bdbc226bc0bacff6bfdf65a824a4be0eec && rm -rf /opt/netbox/.git

# ---- CPython 3.12.16 compiled from python.org's source against Ubuntu 24.04's own libraries (libssl3t64,
#      libsqlite3-0, libexpat1, zlib1g, ... -- debs the scan sees and apt fixes). This stage only FETCHES the
#      tarball (python.org's sha256, pinned in strategies/netbox.json source.python_runtime) and the build
#      toolchain's debs; `cpython` compiles them with gen_dockerfile.cpython_build_cmd, and the offline build runs
#      the same command on the same vendored inputs -- the interpreter that ships is compiled with the network off. ----
FROM ubuntu:24.04@sha256:9c7f200c07e3d4a03e7249d2c16bf66a51120fb876aa2242cf31451412543289 AS cpython-src
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl && rm -rf /var/lib/apt/lists/* && \
    mkdir -p /vendored-python && curl -fsSL --retry 3 -o /vendored-python/Python-3.12.16.tar.xz https://www.python.org/ftp/python/3.12.16/Python-3.12.16.tar.xz && \
    echo "b5796915dc45ff745cfb4e990a7e7c93d6f546328a102ce31448d69ebc37575c  /vendored-python/Python-3.12.16.tar.xz" | sha256sum -c -
# a FRESH pinned base, nothing installed first: the closure is then complete for the equally fresh offline stage
FROM ubuntu:24.04@sha256:9c7f200c07e3d4a03e7249d2c16bf66a51120fb876aa2242cf31451412543289 AS cpython-debs
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get -y --download-only --no-install-recommends install \
      build-essential pkg-config xz-utils libssl-dev zlib1g-dev libbz2-dev libsqlite3-dev libffi-dev liblzma-dev libzstd-dev uuid-dev libexpat1-dev libncurses-dev libreadline-dev && \
    mkdir -p /debs && cp /var/cache/apt/archives/*.deb /debs/ && echo "vendored $(ls -1 /debs/*.deb | wc -l) CPython build debs"
FROM ubuntu:24.04@sha256:9c7f200c07e3d4a03e7249d2c16bf66a51120fb876aa2242cf31451412543289 AS cpython
ARG SOURCE_DATE_EPOCH=1790712880
ENV SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH}
COPY --from=cpython-debs /debs /tmp/cpython-debs
COPY --from=cpython-src /vendored-python/Python-3.12.16.tar.xz /tmp/Python-3.12.16.tar.xz
RUN set --; for f in /tmp/cpython-debs/*.deb; do [ -e "$f" ] && set -- "$@" "$f"; done; \
    for pass in 1 2 3 4 5; do [ $# -eq 0 ] || dpkg -i --skip-same-version "$@" >/dev/null 2>&1 && break; done; \
    dpkg --configure -a && bad= && for d in "$@"; do p=$(dpkg-deb -f "$d" Package) v=$(dpkg-deb -f "$d" Version); \
      case "$(dpkg-query -W -f='${Version} ${db:Status-Abbrev}' "$p" 2>/dev/null)" in "$v ii"*) ;; *) bad="$bad $p=$v" ;; esac; done && \
    { [ -z "$bad" ] || { echo "vendored debs not installed at their vendored version:$bad" >&2; false; }; } && \
    : "${SOURCE_DATE_EPOCH:?the CPython build needs SOURCE_DATE_EPOCH}" && \
    echo "b5796915dc45ff745cfb4e990a7e7c93d6f546328a102ce31448d69ebc37575c  /tmp/Python-3.12.16.tar.xz" | sha256sum -c - && \
    mkdir -p /usr/src/python && tar -xJf /tmp/Python-3.12.16.tar.xz -C /usr/src/python --strip-components=1 --no-same-owner && \
    rm -rf /tmp/cpython-debs /tmp/Python-3.12.16.tar.xz && cd /usr/src/python && \
    export DEB_BUILD_MAINT_OPTIONS=optimize=-lto && \
    PYCF="$(dpkg-buildflags --get CFLAGS) $(dpkg-buildflags --get CPPFLAGS)" && PYLD="$(dpkg-buildflags --get LDFLAGS)" && \
    ./configure --build=x86_64-linux-gnu --prefix=/usr/local --enable-shared --enable-loadable-sqlite-extensions --enable-option-checking=fatal --disable-test-modules --without-static-libpython --with-ensurepip=install --with-system-expat --without-system-libmpdec --with-dbmliborder= py_cv_module__dbm=n/a py_cv_module__gdbm=n/a py_cv_module__tkinter=n/a && \
    make -j"$(nproc)" "EXTRA_CFLAGS=$PYCF" "LDFLAGS=$PYLD,--strip-all" && \
    rm python && make -j"$(nproc)" "EXTRA_CFLAGS=$PYCF" "LDFLAGS=$PYLD,--strip-all,-rpath='\$\$ORIGIN/../lib'" python && \
    make install COMPILEALL_OPTS=--invalidation-mode=checked-hash && \
    cd / && rm -rf /usr/src/python /usr/local/lib/python3.12/idlelib /usr/local/lib/python3.12/tkinter /usr/local/lib/python3.12/turtledemo /usr/local/bin/idle3* && \
    for s in pip3 pydoc3 python3 python3-config; do ln -sfT "$s" "/usr/local/bin/${s%3*}${s#*3}"; done && \
    ldconfig && /usr/local/bin/python3 -I -B -c "import ssl, sqlite3, zlib, bz2, lzma, ctypes, uuid, pyexpat, decimal, readline, curses, hashlib, sys, importlib.util as u; bad = [m for m in ('_dbm', '_gdbm', '_tkinter') if u.find_spec(m)]; assert not bad, ('built but must not be', bad); print(sys.version.replace(chr(10), ' '), '|', ssl.OPENSSL_VERSION, '| sqlite', sqlite3.sqlite_version, '| expat', pyexpat.EXPAT_VERSION)" && \
    ldd /usr/local/lib/python3.12/lib-dynload/_ssl.cpython-*.so | grep -qE 'libssl.so.3 => /(usr/)?lib/x86_64-linux-gnu/' && ldd /usr/local/lib/python3.12/lib-dynload/_sqlite3.cpython-*.so | grep -qE 'libsqlite3.so.0 => /(usr/)?lib/x86_64-linux-gnu/' && ldd /usr/local/lib/python3.12/lib-dynload/pyexpat.cpython-*.so | grep -qE 'libexpat.so.1 => /(usr/)?lib/x86_64-linux-gnu/' && ldd /usr/local/lib/python3.12/lib-dynload/_ctypes.cpython-*.so | grep -qE 'libffi.so.8 => /(usr/)?lib/x86_64-linux-gnu/' && ldd /usr/local/lib/python3.12/lib-dynload/_lzma.cpython-*.so | grep -qE 'liblzma.so.5 => /(usr/)?lib/x86_64-linux-gnu/' && ldd /usr/local/lib/python3.12/lib-dynload/_bz2.cpython-*.so | grep -qE 'libbz2.so.1.0 => /(usr/)?lib/x86_64-linux-gnu/' && ldd /usr/local/lib/python3.12/lib-dynload/_uuid.cpython-*.so | grep -qE 'libuuid.so.1 => /(usr/)?lib/x86_64-linux-gnu/' && ldd /usr/local/lib/python3.12/lib-dynload/zlib.cpython-*.so | grep -qE 'libz.so.1 => /(usr/)?lib/x86_64-linux-gnu/'

# Every Python stage below starts here: one interpreter for the builders and the runtime, so compiled wheels match.
FROM ubuntu:24.04@sha256:9c7f200c07e3d4a03e7249d2c16bf66a51120fb876aa2242cf31451412543289 AS python-base
ENV LANG=C.UTF-8
COPY --from=cpython /usr/local/ /usr/local/
# ca-certificates netbase tzdata: what the official python images add to their distro base (CA roots for pip and
# ssl, /etc/services, the zoneinfo database Django's TIME_ZONE needs); ubuntu:24.04 has none of them. Then the
# libraries the compiled interpreter loads (gen_dockerfile.PY_SRC_RUNTIME_LIBS) -- Ubuntu debs in the SBOM.
# ldconfig: libpython3.12.so is in /usr/local/lib. userdel: ubuntu:24.04 ships an `ubuntu` account holding uid/gid
# 1000; removing it lets the app account keep the uid 1000 it had on the Debian base (volume ownership unchanged).
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates netbase tzdata \
      libssl3t64 zlib1g libbz2-1.0 libsqlite3-0 libffi8 liblzma5 libzstd1 libuuid1 libexpat1 libncursesw6 libtinfo6 libreadline8t64 && \
    rm -rf /var/lib/apt/lists/* && ldconfig && userdel --remove ubuntu && python3 --version

FROM python-base AS builder
ENV PIP_NO_CACHE_DIR=1
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential pkg-config libpq-dev libssl-dev libxml2-dev libxslt1-dev ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=src /opt/netbox/requirements.txt /tmp/requirements.txt
COPY constraints.txt /tmp/constraints.txt
RUN python -m venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH
RUN pip install -r /tmp/requirements.txt \
 && pip install --upgrade -r /tmp/constraints.txt
# supervisord from PyPI, into the venv (from v4.7.4-CE-ubuntu24.04-r4): Ubuntu's supervisor package needs Ubuntu's own
# python3.12, a second Python whose four packages carried 132 of r2's 201 unfixable medium findings, and the chiselled image
# has no apt. supervisor 4.3.0 (PyPI's newest, 2025-08-23) is pure Python with no dependency (importlib.metadata, no
# setuptools); the wheel is checked against the sha256 PyPI lists for it.
RUN printf 'supervisor==4.3.0 --hash=sha256:0bcb763fddafba410f35cbde226aa7f8514b9fb82eb05a0c85f6588d1c13f8db\n' > /tmp/supervisor.txt \
 && pip install --no-deps --require-hashes -r /tmp/supervisor.txt && /opt/venv/bin/supervisord --version

# the application tree's assembly (collectstatic imports NetBox, whose psycopg[c] loads libpq.so.5). Nothing of this stage's
# system ships: the image is the chiselled runtime (chiselcut below) with /usr/local, /opt/venv and /opt/netbox laid in.
FROM python-base AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PATH=/opt/venv/bin:$PATH
RUN apt-get update && apt-get install -y --no-install-recommends libpq5 && rm -rf /var/lib/apt/lists/*
COPY --from=builder /opt/venv /opt/venv
COPY --from=src /opt/netbox /opt/netbox
COPY configuration.py /opt/netbox/netbox/netbox/configuration.py
COPY gunicorn.py /opt/netbox/gunicorn.py
COPY readystack_wsgi.py /opt/netbox/netbox/readystack_wsgi.py
COPY super_user.py /opt/netbox/super_user.py
COPY supervisor-netbox.conf /etc/supervisor/netbox.conf
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN groupadd -g 1000 netbox && useradd -u 1000 -g netbox -d /opt/netbox -s /usr/sbin/nologin netbox \
 && chmod 755 /usr/local/bin/entrypoint.sh \
 && cd /opt/netbox/netbox && SECRET_KEY="$(head -c40 /dev/urandom | base64 | tr -d '\n' | head -c50)00000" python manage.py collectstatic --no-input \
 && mkdir -p /opt/netbox/netbox/media /opt/netbox/netbox/reports /opt/netbox/netbox/scripts \
 && chown -R netbox:netbox /opt/netbox
# pip is build-only. The interpreter's own pip (/usr/local; 25.0.1 in the former Debian python base) and the
# venv's (/opt/venv, `python -m venv` installs ensurepip's bundled 25.0.1) carry CVE-2026-8643 (HIGH per OSV, fixed in pip 26.1.2;
# chain 477 verdict). Nothing in this image runs pip: the entrypoint, supervisord programs and
# NetBox itself never call it (upgrade.sh does, and this image does not use it). Same fix as
# airflow/changedetection/homeassistant. Stripped here too so the exported tarballs carry no pip.
RUN rm -rf /usr/local/lib/python3.12/site-packages/pip /usr/local/lib/python3.12/site-packages/pip-*.dist-info \
           /usr/local/bin/pip /usr/local/bin/pip3 /usr/local/bin/pip3.12 \
           /opt/venv/lib/python3.12/site-packages/pip /opt/venv/lib/python3.12/site-packages/pip-*.dist-info \
           /opt/venv/bin/pip /opt/venv/bin/pip3 /opt/venv/bin/pip3.12 && \
    for py in /usr/local/bin/python3 /opt/venv/bin/python; do \
      if "$py" -c 'import pip' 2>/dev/null; then echo "pip is still importable by $py" >&2; exit 1; fi; \
    done
WORKDIR /opt/netbox/netbox
USER netbox
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]

FROM runtime AS export-src
USER root
RUN mkdir -p /export && \
    tar czf /export/netbox.tar.gz -C / opt/netbox opt/venv && \
    tar czf /export/site.tar.gz -C / usr/local/lib/python3.12/site-packages && \
    echo "vendored: $(du -sh /export | cut -f1)"
# chiselled runtime (runtime_base): the files the slices need, cut from Ubuntu's own .debs by Canonical's chisel
FROM ubuntu:24.04@sha256:9c7f200c07e3d4a03e7249d2c16bf66a51120fb876aa2242cf31451412543289 AS chiselcut
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl file zstd && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL -o /tmp/chisel.tgz https://github.com/canonical/chisel/releases/download/v1.5.1/chisel_v1.5.1_linux_amd64.tar.gz && \
    echo "89612f46de83e850aae11fca26a32a22cc2964891f2cc538211b906787d2b83e4496fa203a5074e06a9932f1fbe84a73  /tmp/chisel.tgz" | sha384sum -c - && tar -xzf /tmp/chisel.tgz -C /usr/local/bin chisel && \
    curl -fsSL -o /tmp/releases.tgz https://github.com/canonical/chisel-releases/archive/f2600d3aa90123db6d44bb1441a99afc8b5847d9.tar.gz && \
    echo "e5b4484bb283149ed7fc0f42ad2194fed28cae0bf1036704853d60ec31298bef  /tmp/releases.tgz" | sha256sum -c - && \
    mkdir -p /opt/chisel-releases && tar -xzf /tmp/releases.tgz -C /opt/chisel-releases --strip-components=1
RUN mkdir -p /rootfs /cache && XDG_CACHE_HOME=/cache chisel cut --release /opt/chisel-releases --root /rootfs base-files_base base-files_release-info base-files_chisel base-passwd_data ca-certificates_data tzdata_zoneinfo dash_bins coreutils_output-of-entire-files coreutils_env coreutils_echo coreutils_test coreutils_tr-utility coreutils_sort coreutils_head coreutils_tail coreutils_cut coreutils_printf coreutils_working-context coreutils_system-context coreutils_basename coreutils_dirname coreutils_rm-utility coreutils_ln-utility coreutils_readlink coreutils_date coreutils_timeout coreutils_delaying libssl3t64_libs zlib1g_libs libbz2-1.0_libs libsqlite3-0_libs libffi8_libs liblzma5_libs libzstd1_libs libuuid1_libs libexpat1_libs libncursesw6_libs libtinfo6_libs libreadline8t64_libs netbase_config libc-bin_locale bash_bins grep_bins sed_bins coreutils_id-utility libpq5_libs libcrypt1_libs libgcc-s1_libs libstdc++6_libs
RUN set -eu; mkdir -p /chisel/debs /rootfs/var/lib/dpkg; : > /tmp/status; : > /chisel/packages.tsv; \
    for f in /cache/chisel/sha256/* /cache/chisel/sha512/*; do [ -f "$f" ] && file "$f" | grep -q "Debian binary package" || continue; \
      p=$(dpkg-deb -f "$f" Package); v=$(dpkg-deb -f "$f" Version); \
      cp "$f" "/chisel/debs/${p}_${v}.deb"; printf '%s\t%s\t%s\n' "$p" "$v" "$(sha256sum < "$f" | cut -c1-64)" >> /chisel/packages.tsv; done; \
    [ -s /chisel/packages.tsv ] || { echo "no .deb found in the chisel cache" >&2; exit 1; }; \
    LC_ALL=C sort -o /chisel/packages.tsv /chisel/packages.tsv; \
    cut -f1,2 /chisel/packages.tsv | while IFS="$(printf '\t')" read -r p v; do \
      dpkg-deb -f "/chisel/debs/${p}_${v}.deb" | sed '/^Package:/a Status: install ok installed' >> /tmp/status; echo >> /tmp/status; done; \
    install -m 0644 /tmp/status /rootfs/var/lib/dpkg/status; \
    mkdir -p /rootfs/var/lib/dpkg/info; [ -s /rootfs/var/lib/chisel/manifest.wall ] || \
      { echo "no chisel manifest (/var/lib/chisel/manifest.wall): the base-files_chisel slice is missing" >&2; exit 1; }; \
    zstd -dc /rootfs/var/lib/chisel/manifest.wall | grep '"kind":"path"' | \
      sed -n 's/.*"path":"\([^"]*\)".*"slices":\[\([^]]*\)\].*/\1 \2/p' | \
      while read -r path slices; do path=${path%/}; if [ -z "$path" ]; then continue; fi; \
        for s in $(echo "$slices" | tr -d '"' | tr ',' ' '); do echo "$path" >> "/rootfs/var/lib/dpkg/info/${s%%_*}.list"; done; done; \
    cut -f1 /chisel/packages.tsv | while read -r p; do l="/rootfs/var/lib/dpkg/info/$p.list"; [ -f "$l" ] || : > "$l"; \
      LC_ALL=C sort -u -o "$l" "$l"; \
      while read -r f; do if [ -f "/rootfs$f" ] && [ ! -L "/rootfs$f" ]; then (cd /rootfs && md5sum "${f#/}"); fi; done < "$l" \
        > "/rootfs/var/lib/dpkg/info/$p.md5sums"; done; \
    [ "$(ls /rootfs/var/lib/dpkg/info/*.md5sums | wc -l)" = "$(wc -l < /chisel/packages.tsv)" ] || \
      { echo "/var/lib/dpkg/info does not name every package of the cut" >&2; exit 1; }; \
    { echo "chisel v1.5.1"; echo "chisel-releases f2600d3aa90123db6d44bb1441a99afc8b5847d9"; for s in base-files_base base-files_release-info base-files_chisel base-passwd_data ca-certificates_data tzdata_zoneinfo dash_bins coreutils_output-of-entire-files coreutils_env coreutils_echo coreutils_test coreutils_tr-utility coreutils_sort coreutils_head coreutils_tail coreutils_cut coreutils_printf coreutils_working-context coreutils_system-context coreutils_basename coreutils_dirname coreutils_rm-utility coreutils_ln-utility coreutils_readlink coreutils_date coreutils_timeout coreutils_delaying libssl3t64_libs zlib1g_libs libbz2-1.0_libs libsqlite3-0_libs libffi8_libs liblzma5_libs libzstd1_libs libuuid1_libs libexpat1_libs libncursesw6_libs libtinfo6_libs libreadline8t64_libs netbase_config libc-bin_locale bash_bins grep_bins sed_bins coreutils_id-utility libpq5_libs libcrypt1_libs libgcc-s1_libs libstdc++6_libs; do echo "$s"; done; } > /chisel/slices.txt; \
    tar --sort=name --numeric-owner --format=posix --pax-option=delete=atime,delete=ctime -cf /chisel/rootfs.tar -C /rootfs . && \
    echo "chiselled rootfs: $(wc -l < /chisel/packages.tsv) packages, $(du -sh /rootfs | cut -f1)"
FROM scratch AS export
COPY --from=export-src /export/ /netbox-src/
COPY --from=cpython-src /vendored-python/ /netbox-src/python/
COPY --from=cpython-debs /debs/ /netbox-src/python/debs/
COPY --from=chiselcut /chisel /chisel
